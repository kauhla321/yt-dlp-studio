{
  "name": "yt-dlp-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A modern desktop-style web GUI for yt-dlp",
  "author": "kauhla321",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app:build": "next build && node scripts/prepare-standalone.mjs",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently -k -n next,electron -c blue,green \"next dev\" \"wait-on tcp:3000 && electron electron/main.js\"",
    "dist": "npm run app:build && electron-builder --win portable"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "build": {
    "appId": "com.ytdlpstudio.app",
    "productName": "yt-dlp Studio",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      ".next/standalone/**",
      "ICON.ico",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "ICON.ico"
    },
    "portable": {
      "artifactName": "yt-dlp-studio.exe"
    }
  }
}
